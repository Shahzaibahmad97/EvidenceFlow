EVIDENCEFLOW_DATABASE_URL=sqlite:///./evidenceflow.db
EVIDENCEFLOW_PROVIDER=fake
EVIDENCEFLOW_RUN_WORKER=true
EVIDENCEFLOW_SEED_ON_START=true
EVIDENCEFLOW_TIMEOUT_SECONDS=60
EVIDENCEFLOW_AUTO_CREATE_SCHEMA=true
EVIDENCEFLOW_RATE_LIMIT_PER_MINUTE=60
EVIDENCEFLOW_MAX_BODY_BYTES=262144

# Live extraction only. Never set this in a public deployment: the endpoints are
# unauthenticated, so a key on a public URL is anyone's to spend.
EVIDENCEFLOW_OPENAI_MODEL=gpt-4.1-2025-04-14
OPENAI_API_KEY=
